# Platform SuperAdmin token (required in production; omit only with --demo-mode)
TENANT_RAG_ADMIN_TOKEN=replace-with-strong-random-admin-token

# Physical per-tenant SQLite WAL & control plane directory
TENANT_RAG_DATA_DIR=./enterprise_data
HOST=127.0.0.1
PORT=8080

# Optional OpenAI-compatible Embedding endpoint (defaults to offline FakeEmbedder)
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_REVISION=2024-02

# Optional OpenAI-compatible Chat LLM endpoint (defaults to offline Grounded Extractive Synthesis)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional Rerank endpoint (defaults to built-in zero-dep LexicalCrossReranker)
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=bge-reranker-v2-m3
